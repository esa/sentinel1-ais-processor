CC = x86_64-w64-mingw32-gcc
CFLAGS = -O2 -Wall -pthread
LDFLAGS = -lm -pthread

SRC = AIS_receiver.c AIS_subroutines.c
OBJ = $(SRC:.c=.o)
TARGET = AIS_receiver.exe

all: $(TARGET)

$(TARGET): $(OBJ)
	$(CC) $(OBJ) -o $(TARGET) $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJ) $(TARGET)
